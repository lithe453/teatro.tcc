def mostrar_sala_gui(numero_sala):

    janela = tk.Toplevel(root)

    janela.title(f"Sala {numero_sala + 1}")
    janela.geometry("1000x600")

    tk.Label(
        janela,
        text=f"SALA {numero_sala + 1}",
        font=("Arial", 20, "bold")
    ).pack(pady=10)

    frame = tk.Frame(janela)
    frame.pack()

    try:

        conexao = conectar_banco()
        cursor = conexao.cursor()

        cursor.execute(
            """
            SELECT
                a.fila,
                a.lugar,
                CASE
                    WHEN r.id_reserva IS NULL THEN 0
                    ELSE 1
                END AS reservado

            FROM assento a

            LEFT JOIN reserva r
            ON a.id_assento = r.id_assento

            WHERE a.id_sala = %s

            ORDER BY a.fila, a.lugar
            """,
            (numero_sala + 1,)
        )

        assentos = cursor.fetchall()

        cursor.close()
        conexao.close()

    except Exception as erro:

        messagebox.showerror(
            "Erro",
            f"Erro ao acessar o banco:\n{erro}"
        )

        return

    for fila, lugar, reservado in assentos:

        if lugar == 0:

            tk.Label(
                frame,
                text=f"Fila {fila}",
                width=8
            ).grid(
                row=fila,
                column=0,
                padx=2,
                pady=2
            )

        if reservado == 0:

            cor = "green"
            texto = str(lugar)

        else:

            cor = "red"
            texto = "X"

        tk.Label(
            frame,
            text=texto,
            width=3,
            bg=cor,
            fg="white"
        ).grid(
            row=fila,
            column=lugar + 1,
            padx=2,
            pady=2
        )

    tk.Label(
        janela,
        text="Verde = Livre     Vermelho = Reservado",
        font=("Arial", 12)
    ).pack(pady=20)

def abrir_reservar():

    janela = tk.Toplevel(root)

    janela.title("Reservar Lugar")
    janela.geometry("400x400")

    tk.Label(
        janela,
        text="Reservar Lugar",
        font=("Arial", 18, "bold")
    ).pack(pady=15)

    tk.Label(
        janela,
        text="Sala:"
    ).pack()

    sala_var = tk.IntVar(value=1)

    tk.OptionMenu(
        janela,
        sala_var,
        *range(1, NUM_SALAS + 1)
    ).pack(pady=5)

    tk.Label(
        janela,
        text="Fila:"
    ).pack()

    fila_var = tk.IntVar(value=0)

    tk.OptionMenu(
        janela,
        fila_var,
        *range(NUM_FILAS)
    ).pack(pady=5)

    tk.Label(
        janela,
        text="Lugar:"
    ).pack()

    lugar_var = tk.IntVar(value=0)

    tk.OptionMenu(
        janela,
        lugar_var,
        *range(LUGARES_POR_FILA)
    ).pack(pady=5)

    def reservar():

        sala = sala_var.get()
        fila = fila_var.get()
        lugar = lugar_var.get()

        try:

            conexao = conectar_banco()
            cursor = conexao.cursor()

            cursor.execute(
                """
                SELECT id_assento
                FROM assento
                WHERE id_sala = %s
                AND fila = %s
                AND lugar = %s
                """,
                (sala, fila, lugar)
            )

            resultado = cursor.fetchone()

            if resultado is None:

                messagebox.showerror(
                    "Erro",
                    "Assento não encontrado!"
                )

                cursor.close()
                conexao.close()

                return

            id_assento = resultado[0]

            cursor.execute(
                """
                SELECT id_reserva
                FROM reserva
                WHERE id_assento = %s
                """,
                (id_assento,)
            )

            reserva_existente = cursor.fetchone()

            if reserva_existente:

                messagebox.showerror(
                    "Erro",
                    "Esse lugar já está reservado!"
                )

            else:

                cursor.execute(
                    """
                    INSERT INTO reserva (id_assento)
                    VALUES (%s)
                    """,
                    (id_assento,)
                )

                conexao.commit()

                messagebox.showinfo(
                    "Sucesso",
                    "Lugar reservado com sucesso!"
                )

            cursor.close()
            conexao.close()

        except Exception as erro:

            messagebox.showerror(
                "Erro",
                f"Erro ao reservar:\n{erro}"
            )

    tk.Button(
        janela,
        text="Reservar",
        width=20,
        command=reservar
    ).pack(pady=20)

def abrir_cancelar():

    janela = tk.Toplevel(root)

    janela.title("Cancelar Reserva")
    janela.geometry("400x400")

    tk.Label(
        janela,
        text="Cancelar Reserva",
        font=("Arial", 18, "bold")
    ).pack(pady=15)

    tk.Label(
        janela,
        text="Sala:"
    ).pack()

    sala_var = tk.IntVar(value=1)

    tk.OptionMenu(
        janela,
        sala_var,
        *range(1, NUM_SALAS + 1)
    ).pack(pady=5)

    tk.Label(
        janela,
        text="Fila:"
    ).pack()

    fila_var = tk.IntVar(value=0)

    tk.OptionMenu(
        janela,
        fila_var,
        *range(NUM_FILAS)
    ).pack(pady=5)

    tk.Label(
        janela,
        text="Lugar:"
    ).pack()

    lugar_var = tk.IntVar(value=0)

    tk.OptionMenu(
        janela,
        lugar_var,
        *range(LUGARES_POR_FILA)
    ).pack(pady=5)

    def cancelar():

        sala = sala_var.get()
        fila = fila_var.get()
        lugar = lugar_var.get()

        try:

            conexao = conectar_banco()
            cursor = conexao.cursor()

            cursor.execute(
                """
                SELECT id_assento
                FROM assento
                WHERE id_sala = %s
                AND fila = %s
                AND lugar = %s
                """,
                (sala, fila, lugar)
            )

            resultado = cursor.fetchone()

            if resultado is None:

                messagebox.showerror(
                    "Erro",
                    "Assento não encontrado!"
                )

                cursor.close()
                conexao.close()

                return

            id_assento = resultado[0]

            cursor.execute(
                """
                DELETE FROM reserva
                WHERE id_assento = %s
                """,
                (id_assento,)
            )

            if cursor.rowcount > 0:

                conexao.commit()

                messagebox.showinfo(
                    "Sucesso",
                    "Reserva cancelada!"

                )

            else:

                messagebox.showerror(
                    "Erro",
                    "Esse lugar não está reservado!"
                )


            cursor.close()
            conexao.close()

        except Exception as erro:

            messagebox.showerror(
                "Erro",
                f"Erro ao cancelar:\n{erro}"
            )

    tk.Button(
        janela,
        text="Cancelar reserva",
        width=20,
        command=cancelar
    ).pack(pady=20)

