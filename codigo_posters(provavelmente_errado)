import tkinter as tk
from tkinter import messagebox
from PIL import Image, ImageTk

NUM_SALAS = 3
NUM_FILAS = 10
LUGARES_POR_FILA = 20

posters = [
    "/mnt/data/spider-man.png",
    "/mnt/data/the-odyssey.png",
    "/mnt/data/Toy-Story-5.png"
]

nomes_filmes = [
    "Spider-Man: Brand New Day",
    "The Odyssey",
    "Toy Story 5"
]

salas = []

for sala in range(NUM_SALAS):

    teatro = []

    for fila in range(NUM_FILAS):
        teatro.append([0] * LUGARES_POR_FILA)

    salas.append(teatro)

def abrir_mostrar_sala():

    janela = tk.Toplevel(root)

    janela.title("Mostrar Sala")
    janela.geometry("700x600")

    tk.Label(
        janela,
        text="Escolha uma sala:",
        font=("Arial", 16, "bold")
    ).pack(pady=20)

    for i in range(NUM_SALAS):

        botao = tk.Button(
            janela,
            text=f"Sala {i + 1} - {nomes_filmes[i]}",
            width=35,
            height=2,
            command=lambda sala=i: mostrar_sala_gui(sala)
        )

        botao.pack(pady=8)

def mostrar_sala_gui(numero_sala):

    janela = tk.Toplevel(root)

    janela.title(
        f"Sala {numero_sala + 1} - {nomes_filmes[numero_sala]}"
    )

    janela.geometry("1200x700")

    tk.Label(
        janela,
        text=f"SALA {numero_sala + 1}",
        font=("Arial", 22, "bold")
    ).pack(pady=10)

    tk.Label(
        janela,
        text=nomes_filmes[numero_sala],
        font=("Arial", 16, "bold"),
        fg="darkblue"
    ).pack(pady=5)

    frame_principal = tk.Frame(janela)

    frame_principal.pack(
        fill="both",
        expand=True,
        padx=20,
        pady=10
    )

    frame_poster = tk.Frame(frame_principal)

    frame_poster.pack(
        side="left",
        padx=30,
        pady=10
    )


    imagem = Image.open(posters[numero_sala])

    imagem.thumbnail((220, 320))

    poster = ImageTk.PhotoImage(imagem)


    tk.Label(
        frame_poster,
        image=poster
    ).pack()

    frame_lugares = tk.Frame(frame_principal)

    frame_lugares.pack(
        side="left",
        padx=20,
        pady=10
    )

    tk.Label(
        frame_lugares,
        text="TELA",
        font=("Arial", 14, "bold"),
        bg="black",
        fg="white",
        width=70
    ).grid(
        row=0,
        column=0,
        columnspan=LUGARES_POR_FILA + 1,
        pady=10
    )

    sala = salas[numero_sala]

    for fila in range(NUM_FILAS):

        tk.Label(
            frame_lugares,
            text=f"Fila {fila}",
            width=8
        ).grid(
            row=fila + 1,
            column=0,
            padx=2,
            pady=2
        )

        for lugar in range(LUGARES_POR_FILA):

            if sala[fila][lugar] == 0:

                cor = "green"
                texto = str(lugar)

            else:

                cor = "red"
                texto = "X"


            tk.Label(
                frame_lugares,
                text=texto,
                width=3,
                bg=cor,
                fg="white"
            ).grid(
                row=fila + 1,
                column=lugar + 1,
                padx=2,
                pady=2
            )

    janela.poster = poster

def abrir_reservar():

    janela = tk.Toplevel(root)

    janela.title("Reservar Lugar")
    janela.geometry("400x350")


    tk.Label(
        janela,
        text="Reservar Lugar",
        font=("Arial", 18, "bold")
    ).pack(pady=15)

    tk.Label(
        janela,
        text="Sala:"
    ).pack()

    sala_var = tk.IntVar(value=1)

    sala_menu = tk.OptionMenu(
        janela,
        sala_var,
        *range(1, NUM_SALAS + 1)
    )

    sala_menu.pack(pady=5)

    tk.Label(
        janela,
        text="Fila:"
    ).pack()

    fila_var = tk.IntVar(value=0)

    fila_menu = tk.OptionMenu(
        janela,
        fila_var,
        *range(NUM_FILAS)
    )

    fila_menu.pack(pady=5)

    tk.Label(
        janela,
        text="Lugar:"
    ).pack()

    lugar_var = tk.IntVar(value=0)

    lugar_menu = tk.OptionMenu(
        janela,
        lugar_var,
        *range(LUGARES_POR_FILA)
    )

    lugar_menu.pack(pady=5)


    def reservar():

        sala = sala_var.get() - 1
        fila = fila_var.get()
        lugar = lugar_var.get()


        if salas[sala][fila][lugar] == 0:

            salas[sala][fila][lugar] = 1

            messagebox.showinfo(
                "Sucesso",
                "Lugar reservado com sucesso!"
            )

        else:

            messagebox.showerror(
                "Erro",
                "Esse lugar já está reservado!"
            )


    tk.Button(
        janela,
        text="Reservar",
        width=20,
        command=reservar
    ).pack(pady=20)

def abrir_cancelar():

    janela = tk.Toplevel(root)

    janela.title("Cancelar Reserva")
    janela.geometry("400x350")


    tk.Label(
        janela,
        text="Cancelar Reserva",
        font=("Arial", 18, "bold")
    ).pack(pady=15)

    tk.Label(
        janela,
        text="Sala:"
    ).pack()

    sala_var = tk.IntVar(value=1)

    tk.OptionMenu(
        janela,
        sala_var,
        *range(1, NUM_SALAS + 1)
    ).pack(pady=5)

    tk.Label(
        janela,
        text="Fila:"
    ).pack()

    fila_var = tk.IntVar(value=0)

    tk.OptionMenu(
        janela,
        fila_var,
        *range(NUM_FILAS)
    ).pack(pady=5)

    tk.Label(
        janela,
        text="Lugar:"
    ).pack()

    lugar_var = tk.IntVar(value=0)

    tk.OptionMenu(
        janela,
        lugar_var,
        *range(LUGARES_POR_FILA)
    ).pack(pady=5)


    def cancelar():

        sala = sala_var.get() - 1
        fila = fila_var.get()
        lugar = lugar_var.get()


        if salas[sala][fila][lugar] == 1:

            salas[sala][fila][lugar] = 0

            messagebox.showinfo(
                "Sucesso",
                "Reserva cancelada!"
            )

        else:

            messagebox.showerror(
                "Erro",
                "Esse lugar não está reservado!"
            )


    tk.Button(
        janela,
        text="Cancelar reserva",
        width=20,
        command=cancelar
    ).pack(pady=20)

root = tk.Tk()

root.title("Gerenciador de Teatro/Cinema")

root.geometry("400x400")


tk.Label(
    root,
    text="CINEVERSE",
    font=("Roboto", 24, "bold")
).pack(pady=30)


tk.Button(
    root,
    text="1 - Mostrar sala",
    width=25,
    height=2,
    command=abrir_mostrar_sala
).pack(pady=5)


tk.Button(
    root,
    text="2 - Reservar lugar",
    width=25,
    height=2,
    command=abrir_reservar
).pack(pady=5)


tk.Button(
    root,
    text="3 - Cancelar reserva",
    width=25,
    height=2,
    command=abrir_cancelar
).pack(pady=5)


tk.Button(
    root,
    text="4 - Fechar programa",
    width=25,
    height=2,
    command=root.destroy
).pack(pady=5)


root.mainloop()
